# Copie para .env antes de rodar "docker compose up --build". O .env não é versionado.
# Os valores abaixo funcionam para uso local; troque todos em qualquer outro ambiente.

POSTGRES_DB=estoque
POSTGRES_USER=estoque
POSTGRES_PASSWORD=troque-esta-senha-local

# Chave exigida no cabeçalho X-Api-Key, com no mínimo 32 caracteres.
# A chave do legado está comprometida e não deve ser reaproveitada. Para gerar uma nova: openssl rand -hex 32
API_KEY=troque-por-uma-chave-aleatoria-de-32-caracteres-ou-mais
